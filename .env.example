# --- Tracing (llm/client.py, read directly by the langsmith SDK) ---
# Every LLM/embedding call goes through llm/client.py, which is wrapped with
# langsmith. Set these three to see requests, latency, and failures per
# module (filter by tag: module_a / module_b / evaluation / memory) at
# https://smith.langchain.com. Omit all three to leave tracing off -- the
# wrapper is then a zero-op passthrough.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=brand-management
# Only needed if your LangSmith org/workspace is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
